<Window x:Class="WpfApp2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid Margin="0,0,0,-6" Background="#FFC6C6C6">
        <Button x:Name="kukla_btn" Content="KUKLA" HorizontalAlignment="Left" Margin="39,23,0,0" VerticalAlignment="Top" Height="100" Width="160"  FontWeight="Bold" Click="kukla_btn_Click" FontSize="30"/>
        <Button x:Name="jazda_btn" Content="JAZDA" HorizontalAlignment="Left" Margin="39,160,0,0" VerticalAlignment="Top" Height="100" Width="160"  FontWeight="Bold" Click="jazda_btn_Click" FontSize="30"/>
        <TextBlock x:Name="block_txt" HorizontalAlignment="Left" Margin="454,23,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Height="254" Width="277" Background="#FFA0DDE2" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.CanContentScroll="True"/>
        <Button x:Name="novynakup_btn" Content="NOVÝ NÁKUP" HorizontalAlignment="Left" Margin="454,322,0,0" VerticalAlignment="Top" Height="77" Width="277" FontWeight="Bold" Click="novynakup_btn_Click" FontSize="30"/>
        <Label x:Name="celkovacena_txt" Content="CELKOVÁ CENA:" HorizontalAlignment="Left" Margin="454,282,0,0" VerticalAlignment="Top" Height="35" Width="277" Background="#FFA0DDE2" FontWeight="Bold" FontSize="20"/>

        <Button x:Name="jedlo_btn" Content="JEDLO" HorizontalAlignment="Left" Margin="219,23,0,0" VerticalAlignment="Top" Height="100" Width="169"  FontWeight="Bold" Click="jedlo_btn_Click" FontSize="30"/>
        <Button x:Name="magnetka_btn" Content="MAGNETKA" HorizontalAlignment="Left" Margin="219,160,0,0" VerticalAlignment="Top" Height="100" Width="169"  FontWeight="Bold" Click="magnetka_btn_Click" FontSize="27"/>
        <Button x:Name="prenajom_btn" Content="1H &#xD;&#xA;PRENAJOM" HorizontalAlignment="Left" Margin="219,288,0,0" VerticalAlignment="Top" Height="94" Width="169"  FontWeight="Bold" Click="prenajom_btn_Click" FontSize="25"/>
        <Button x:Name="kofola_btn" Content="KOFOLA" HorizontalAlignment="Left" Margin="39,288,0,0" VerticalAlignment="Top" Height="94" Width="160"  FontWeight="Bold" Click="kofola_btn_Click" FontSize="30"/>

    </Grid>
</Window>
